# Integration tests run each adapter's contract suite against a real database
# when its variables are set, and skip it otherwise. These point at the local
# stack from `pnpm db:start`. Copy to .env and paste the "Secret" key from
# `pnpm db:status` to enable the Supabase suite.
SUPABASE_URL=http://127.0.0.1:55321
SUPABASE_SECRET_KEY=
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:55322/postgres
