# Integration tests run each adapter's contract suite against a real database
# when its variables are set, and skip it otherwise. These point at the local
# stack from `pnpm db:start`. Copy to .env and paste the "Secret" key from
# `pnpm db:status` to enable the Supabase suite.
SUPABASE_URL=http://127.0.0.1:55321
SUPABASE_SECRET_KEY=
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:55322/postgres
# Also run the contract suite as dossier_app, which row level security applies
# to. Give the local role a password first, as postgres:
#   alter role dossier_app with password 'dossier-app-local';
# DATABASE_APP_URL=postgresql://dossier_app:dossier-app-local@127.0.0.1:55322/postgres
