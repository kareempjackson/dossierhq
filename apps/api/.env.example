PORT=4000
# Comma-separated origins allowed to call the API from a browser.
CORS_ORIGINS=http://localhost:3000

# How long a sign-in lasts (1 to 90 days).
# SESSION_DAYS=30

# Encrypts the credentials of connected tools and workspaces' AI API keys:
# 32 random bytes, base64. Generate with `openssl rand -base64 32`. Keep it
# secret and keep it stable; changing it means connecting every tool, and
# adding every API key, again.
CONNECTOR_SECRET_KEY=

# How often connected tools sync, in minutes (0 turns scheduled syncs off).
# SYNC_INTERVAL_MINUTES=15

# How often Dossier looks for weekly reports to draft or send on each
# workspace's schedule (Settings → Weekly reports), in minutes. 0 turns
# scheduled drafting and sending off.
# REPORT_SCHEDULE_MINUTES=5

# How often Dossier looks for events to hand on (a sync that stopped, a
# report that couldn't be sent) and turn into notifications, in seconds.
# New events are handed on at once; this catches retries and anything left
# when the API stopped. 0 turns it off, and events wait.
# EVENTS_POLL_SECONDS=15
# How long people's notifications are kept, read or not, in days.
# NOTIFICATION_DAYS=90

# Which adapter backs the repositories: supabase | postgres | memory
DATABASE_PROVIDER=supabase

# --- supabase -----------------------------------------------------------------
# Local: run `pnpm db:status` and paste its "Secret" key below.
# Production: your project's URL and a secret key (sb_secret_…) or the legacy
# service_role key. Never commit this key or expose it to the browser.
SUPABASE_URL=http://127.0.0.1:55321
SUPABASE_SECRET_KEY=

# --- postgres -----------------------------------------------------------------
# Any Postgres: Supabase (direct or pooler), Neon, RDS, Cloud SQL, local…
# DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:55322/postgres
# In production, connect as dossier_app so the database enforces tenants
# (see Tenant isolation in the README):
# DATABASE_URL=postgresql://dossier_app.<project-ref>:<password>@<region>.pooler.supabase.com:6543/postgres
# DATABASE_POOL_MAX=10
# Set to false behind a transaction-mode pooler (e.g. Supabase port 6543).
# DATABASE_PREPARED_STATEMENTS=true

# --- memory --------------------------------------------------------------------
# No database at all: starts empty, and forgets everything when the API
# restarts. Fine for trying things out.

# --- intelligence ---------------------------------------------------------------
# Dossier's own Anthropic key: workspaces without a key of their own draft with
# Claude on it. Leave unset and each workspace drafts only once it adds its own
# key (Anthropic, OpenAI, Google or xAI) in Settings → API keys, which needs
# CONNECTOR_SECRET_KEY. Get a key at https://platform.claude.com.
# ANTHROPIC_API_KEY=
# The model to draft with until a workspace picks one in Settings: any id in
# packages/contracts/src/models.ts, e.g. claude-opus-5-5 (default),
# claude-sonnet-5-5, gpt-6.1-sol, gemini-4-argon or grok-4.7.
# INTELLIGENCE_MODEL=claude-opus-5-5

# --- email ----------------------------------------------------------------------
# How Dossier sends password resets, invites and reports. "log" (the default)
# sends nothing and writes each email, links included, to the API's log.
# MAIL_PROVIDER=log
# For real email, create a Postmark server, add your sender as a sender
# signature (or verify its domain), and paste the server's API token.
# MAIL_PROVIDER=postmark
# MAIL_FROM="Dossier <dossier@yourmsp.com>"
# POSTMARK_SERVER_TOKEN=

# --- forwarding meeting notes ------------------------------------------------------
# Lets people forward meeting notes to their workspace's own address. Both or
# neither. The address is your Postmark server's inbound address (Default
# Inbound Stream → Settings); set the webhook there to
# https://postmark:<token>@<your API>/inbound/postmark
# with the token below (at least 32 characters: `openssl rand -hex 32`).
# INBOUND_EMAIL_ADDRESS=abc123@inbound.postmarkapp.com
# INBOUND_WEBHOOK_TOKEN=

# --- audit log ------------------------------------------------------------------
# How long the audit log keeps reads from tools, and sign-ins and changes.
# AUDIT_READ_DAYS=90
# AUDIT_EVENT_DAYS=365

# --- visitors' addresses -----------------------------------------------------
# Shared with the web app (CLIENT_IP_KEY in apps/web/.env.local), so the API
# can trust the visitor's address the web app passes on: per-address limits on
# sign-in, sign-up and reset emails, and addresses on sign-ins in the audit
# log. At least 32 characters: `openssl rand -base64 32`.
# CLIENT_IP_KEY=

# --- Dossier Admin ----------------------------------------------------------------
# Shared with the admin app (ADMIN_API_KEY in apps/admin/.env.local): every
# /admin request must carry it, so only the admin app's server reaches them.
# At least 32 characters: `openssl rand -base64 32`. Unset, /admin is 404.
# ADMIN_API_KEY=
# Where staff open the admin app, for staff invite links.
# ADMIN_URL=http://localhost:3001
# How long a staff sign-in lasts, and how long it may go unused.
# STAFF_SESSION_HOURS=12
# STAFF_IDLE_MINUTES=60
