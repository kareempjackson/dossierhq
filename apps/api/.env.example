PORT=4000
# Comma-separated origins allowed to call the API from a browser.
CORS_ORIGINS=http://localhost:3000

# Which adapter backs the repositories: supabase | postgres | memory
DATABASE_PROVIDER=supabase

# --- supabase -----------------------------------------------------------------
# Local: run `pnpm db:status` and paste its "Secret" key below.
# Production: your project's URL and a secret key (sb_secret_…) or the legacy
# service_role key. Never commit this key or expose it to the browser.
SUPABASE_URL=http://127.0.0.1:55321
SUPABASE_SECRET_KEY=

# --- postgres -----------------------------------------------------------------
# Any Postgres: Supabase (direct or pooler), Neon, RDS, Cloud SQL, local…
# DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:55322/postgres
# DATABASE_POOL_MAX=10
# Set to false behind a transaction-mode pooler (e.g. Supabase port 6543).
# DATABASE_PREPARED_STATEMENTS=true
