# Where the Next.js server reaches the NestJS API. Server-only: the browser
# never talks to the API or the database directly.
API_URL=http://localhost:4000

# The same value as CLIENT_IP_KEY in apps/api/.env (`openssl rand -base64 32`),
# so the API learns each visitor's address for per-address sign-in limits and
# the audit log. Leave both unset to go without.
# CLIENT_IP_KEY=

# Preview list states without changing data (dev only): empty | error | slow
# PREVIEW_STATE=

