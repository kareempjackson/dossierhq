# Where the Next.js server reaches the NestJS API. Server-only: the browser
# never talks to the API or the database directly.
API_URL=http://localhost:4000

# Preview list states without changing data (dev only): empty | error | slow
# PREVIEW_STATE=

# Shows a "Use demo account" box on the sign-in page. Matches the seeded demo
# user (pnpm db:seed); leave unset anywhere real people sign in.
DEMO_ACCOUNT_EMAIL=sam@larkspur-it.example
DEMO_ACCOUNT_PASSWORD=larkspur-demo
