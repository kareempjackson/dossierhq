# Where the admin app's server reaches the NestJS API. Server-only: the
# browser never talks to the API or the database directly.
API_URL=http://localhost:4000

# The same value as ADMIN_API_KEY in apps/api/.env (`openssl rand -base64 32`).
# Every /admin request carries it; without it the API answers 404.
ADMIN_API_KEY=

# The same value as CLIENT_IP_KEY in apps/api/.env, so staff sign-ins are
# limited per address and the staff log shows where they came from.
# CLIENT_IP_KEY=
